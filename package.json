{
  "name": "mdzip-viewer",
  "version": "1.1.0",
  "description": "TypeScript viewer for MarkdownZip (.mdz) packages, published as an npm library.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "mdz",
    "markdownzip",
    "markdown",
    "viewer",
    "reader",
    "zip"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mdzip-project/mdzip-viewer"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "marked": "^15.0.12",
    "mdzip-core-js": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
